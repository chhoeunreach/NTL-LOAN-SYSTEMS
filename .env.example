APP_NAME="Loan Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Optional: public website URL opened by the "Website" button in the admin top nav. Empty = app home page.
LOAN_MANAGEMENT_WEBSITE_URL=
APP_TIMEZONE=Asia/Bangkok

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=s_loanmanagement
DB_USERNAME=root
DB_PASSWORD=

DB_LOAN_HOST=127.0.0.1
DB_LOAN_PORT=3306
DB_LOAN_DATABASE=s_loanmanagement
DB_LOAN_USERNAME=root
DB_LOAN_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

LOAN_CUSTOMER_API_DRIVER=passport
LOAN_CHAT_REALTIME_DRIVER=none
LOAN_CHAT_POLLING_INTERVAL=5
LOAN_SEED_DEMO_DATA=true

LOAN_CHAT_TELEGRAM_BOT_TOKEN=
LOAN_CHAT_TELEGRAM_BOT_USERNAME=
LOAN_CHAT_TELEGRAM_WEBHOOK_SECRET=
# Optional: overrides the webhook URL used for Telegram. Needed when tunneling localhost.
# If empty, defaults to APP_URL/webhook/loan-telegram.
LOAN_CHAT_TELEGRAM_WEBHOOK_URL=

OPENAI_API_KEY=
GOOGLE_CLOUD_VISION_API_KEY=
